{
	"name": "ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node ./scripts/fix-csp-hashes.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:comments-ui": "node tests/comments-ui.mjs",
		"test:feed-menu": "node tests/feed-menu.mjs",
		"test:feed-ux": "node tests/feed-ux.mjs",
		"test:feed-preferences": "node tests/feed-preferences.mjs",
		"test:comments-moderation": "node tests/comments-moderation.mjs",
		"test:moderator-gate": "node tests/moderator-gate.mjs",
		"test:discussions": "node tests/discussions.mjs",
		"test:replies": "node tests/replies.mjs",
		"test:reply-worker": "node tests/reply-service-worker.mjs",
		"test:moderator-scroll": "node tests/moderator-scroll.mjs",
		"test:client-version": "node tests/client-version.mjs",
		"test:feed-suggestions": "node tests/feed-suggestions.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@iconify-json/material-symbols": "^1.2.76",
		"@iconify/json": "^2.2.482",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"playwright": "^1.64.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"terser": "^5.48.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
