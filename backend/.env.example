POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://timescaledb:change-me@127.0.0.1:55432/greeklish_feed
INTERNAL_API_TOKEN=change-me
BIND_ADDRESS=127.0.0.1
WS_PING_INTERVAL_SECS=30
WS_TIMEOUT_SECS=60
TICKER_INTERVAL_SECS=30
DEFAULT_FEED_SIZE=20
HOT_GRAVITY=1.8
RUST_ENV=development
PORT=3000
REQUIRED_CLIENT_VERSION=

# --- Guest comments ---
# The feature stays disabled until all three secrets below are set. Setting only some of them is a
# startup error. Generate each with: openssl rand -base64 48
COMMENT_IP_PEPPER=
CAPTCHA_HMAC_KEY=
# Argon2id PHC string. Generate out of band and never commit the real value:
#   argon2 "$(head -c 16 /dev/urandom | base64)" -id -t 3 -m 16 -p 1 -e
MODERATOR_PASSWORD_ARGON2_HASH=
MODERATION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COMMENT_AUTO_APPROVE_THRESHOLD=5
COMMENT_MAX_LENGTH=1000
COMMENT_MAX_PENDING_PER_AUTHOR=3
COMMENT_IP_RETENTION_DAYS=90
CAPTCHA_MAX_NUMBER=150000
CAPTCHA_TTL_SECS=300
MODERATOR_SESSION_TTL_SECS=28800
SWEEPER_INTERVAL_SECS=60

# Optional account-free, per-comment Web Push. Leave the private key empty to disable push.
# Generate a P-256 private key as URL-safe base64 without padding; keep it stable across releases.
# The public key is derived and served at /api/push/config; never publish the private key.
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://greeklish.gr/
